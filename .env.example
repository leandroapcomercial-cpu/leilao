# ==========================================
# LEILÃO FÁCIL v2.0 - CONFIGURAÇÃO
# ==========================================

# Servidor
PORT=3000
NODE_ENV=development

# Banco de dados
# Deixe vazio para usar SQLite local
# Preencha com a URL do Supabase para usar PostgreSQL em produção
DATABASE_URL=

# Segurança
JWT_SECRET=sua_chave_jwt_super_secreta_aqui_minimo_32_caracteres
ADMIN_PASSWORD_HASH=$2a$10$... # Gerar com bcrypt

# Mercado Pago (PIX)
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-...
MERCADO_PAGO_WEBHOOK_SECRET=seu_webhook_secret

# Chave PIX da conta
CHAVE_PIX=seu_email_ou_cpf_aqui

# CORS - Domínios permitidos (separados por vírgula)
CORS_ORIGINS=https://seudominio.com,https://www.seudominio.com

# Influencer (comissão padrão em %)
COMISSAO_PADRAO=10

# Supabase (opcional - para Storage de imagens)
# SUPABASE_URL=https://seu-projeto.supabase.co
# SUPABASE_SERVICE_KEY=sua_chave_service_role

# URL pública do site (para links nos e-mails e metatags Open Graph)
SITE_URL=https://seudominio.com

# Notificações por E-mail (Brevo / Sendinblue)
# Chave de API HTTP (deve começar com "xkeysib", NÃO use a chave SMTP "xsmtps")
BREVO_API_KEY=xkeysib-...
BREVO_SENDER_EMAIL=nao-responda@leilaofacil.com
